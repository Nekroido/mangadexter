<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="chapters-sample.json" />
    <Compile Include="ApiClient.fs" />
    <Compile Include="Manga.fs" />
    <Compile Include="Chapter.fs" />
    <Compile Include="ChapterDownload.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Control.AsyncSeq" Version="3.2.1" />
    <PackageReference Include="FSharp.Data" Version="6.4.1" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="4.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mangadexter.Core\Mangadexter.Core.fsproj" />
  </ItemGroup>

</Project>
