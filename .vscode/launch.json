{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Console App",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build: App.fsproj",
      "program": "${workspaceFolder}/src/App/bin/Debug/net10.0/App.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "requireExactSource": false,
      "logging": {
        "logging.diagnosticsLog.protocolMessages": false
      }
    },
    {
      "name": "Debug: Run App (Release)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build: App.fsproj (Release)",
      "program": "${workspaceFolder}/src/App/bin/Release/net10.0/App.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "requireExactSource": false
    },
    {
      "name": "Attach: Process",
      "type": "coreclr",
      "request": "attach",
      "requireExactSource": false
    },
    {
      "name": "Attach: xUnit Tests",
      "type": "coreclr",
      "request": "attach",
      "requireExactSource": false,
      "processId": "${command:pickProcess}"
    }
  ]
}
