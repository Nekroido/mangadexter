root = true

[*.{fs,fsx}]
max_line_length=90
end_of_line=lf
insert_final_newline=true
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
max_line_length = 90

[*.{fs,fsx}]
indent_size = 4

[*.json]
indent_size = 2
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2
max_line_length = 120
